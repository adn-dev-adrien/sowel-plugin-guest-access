+    expect(isOnPage("/plugins/guest-access/page", main)).toBe(true);
+    // The Plugins admin screen itself is not the page.
+    expect(isOnPage("/plugins", main)).toBe(false);
+    expect(isOnPage("/plugins/other/page", main)).toBe(false);

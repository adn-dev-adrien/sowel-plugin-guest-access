{
  "id": "guest-access",
  "type": "integration",
  "name": "Guest Access",
  "version": "1.0.0",
  "description": "Holds a channel open to Portier and brings the gate commands of the gîte and lodge guests into Sowel",
  "icon": "DoorOpen",
  "repo": "adn-dev-adrien/sowel-plugin-guest-access",
  "author": "adn-dev-adrien",
  "tags": ["access", "guests"],
  "i18n": {
    "fr": {
      "name": "Accès invités",
      "description": "Tient un canal ouvert vers Portier et fait remonter dans Sowel les commandes du portail des clients du gîte et de la lodge"
    }
  },
  "sowelVersion": ">=1.39.0",
  "settings": [
    {
      "key": "portier_url",
      "label": "Portier channel URL",
      "type": "text",
      "required": true,
      "placeholder": "wss://portier.<internal zone>/house/v1"
    },
    {
      "key": "house_key",
      "label": "House key",
      "type": "password",
      "required": true
    },
    {
      "key": "ping_minutes",
      "label": "Channel ping (minutes, 1 to 30)",
      "type": "number",
      "required": false,
      "defaultValue": "10"
    }
  ],
  "apiVersion": 2
}
